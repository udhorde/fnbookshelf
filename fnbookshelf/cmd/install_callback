#!/bin/bash
# 安装后：持久化向导配置 + 准备目录
# 1.6.0 权限加固：
#   - 不在应用根目录下 mkdir etc/ var/（fnOS 里它们是系统创建并授权好的软链接，
#     以 root 强行创建实体目录会让框架后续 chown/ACL「设置目录权限」失败）；
#   - 一律使用系统注入的 TRIM_PKGVAR / TRIM_PKGETC，失败时写明确日志而不是让安装整体失败；
#   - 不对应用目录之外的路径做 chown / setfacl / chmod。
APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VAR_DIR="${TRIM_PKGVAR:-$APP_ROOT/var}"
ETC_DIR="${TRIM_PKGETC:-$APP_ROOT/etc}"
LOGF="${TRIM_TEMP_LOGFILE:-/dev/null}"

PORT="${wizard_port:-8096}"
ADMIN_EMAIL="${wizard_admin_email:-}"

# 目录由 fnOS 创建；这里只补齐子目录，任何失败都不阻断安装
mkdir -p "$VAR_DIR/data" 2>/dev/null || true
if [ ! -d "$VAR_DIR" ] || [ ! -w "$VAR_DIR" ]; then
  echo "数据目录不可写（$VAR_DIR）：请在 fnOS「设置 → 应用 → 授权管理」为本应用授权，或换一个安装存储空间后重试。" > "$LOGF"
fi

# 写入持久配置（幂等：仅首次或字段为空时写入）
if [ ! -f "$ETC_DIR/config.env" ]; then
  if ! cat > "$ETC_DIR/config.env" 2>/dev/null <<CONF
APP_PORT=$PORT
ADMIN_EMAIL=$ADMIN_EMAIL
CONF
  then
    echo "配置目录不可写（$ETC_DIR）：请检查应用安装存储空间权限后重试。" > "$LOGF"
  fi
fi

# 桌面入口的落盘位置（1.9.9：这才是「装完一直没有图标」的真根因）
# fnOS 只认「应用目标目录」里的 ui/，也就是 $APP_ROOT/target/ui → /vol1/@appcenter/<app>/ui；
# 安装包根目录的 ui/ 在安装阶段会被系统处理掉，也不会被复制进 target。1.9.6~1.9.8 一直在
# 改根目录那份，所以图标始终不出现。现在打包时把 ui/ 放进 app.tgz，这里再兜底重建一次。
UI_DIR="$APP_ROOT/target/ui"
UI_CONF="$UI_DIR/config"
fnb_ensure_ui() {
  [ -d "$UI_DIR/images" ] || mkdir -p "$UI_DIR/images" 2>/dev/null || return 1
  [ -s "$UI_DIR/images/icon_64.png" ]  || cp -f "$APP_ROOT/ICON.PNG"     "$UI_DIR/images/icon_64.png"  2>/dev/null
  [ -s "$UI_DIR/images/icon_256.png" ] || cp -f "$APP_ROOT/ICON_256.PNG" "$UI_DIR/images/icon_256.png" 2>/dev/null
  [ -s "$UI_CONF" ] && return 0
  cat > "$UI_CONF" 2>/dev/null <<JSON
{".url":{"fnbookshelf.Application":{"title":"飞牛书屋","icon":"images/icon_{0}.png","type":"url","protocol":"https","port":"$1","url":"/","allUsers":true}}}
JSON
}
fnb_write_ui_port() {
  fnb_ensure_ui "$1" || return 1
  [ -f "$UI_CONF" ] || return 1
  _TMPUI="${UI_CONF}.tmp.$$"
  sed "s/\"port\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"port\": \"$1\"/" "$UI_CONF" > "$_TMPUI" 2>/dev/null || { rm -f "$_TMPUI" 2>/dev/null; return 1; }
  mv -f "$_TMPUI" "$UI_CONF" 2>/dev/null || { rm -f "$_TMPUI" 2>/dev/null; return 1; }
  return 0
}
if [ -n "$PORT" ]; then
  if fnb_write_ui_port "$PORT"; then
    echo "桌面入口已写入端口 $PORT（$UI_CONF）" >> "$LOGF" 2>/dev/null
  else
    echo "桌面入口写入失败（$UI_CONF 不可写）：桌面图标可能不出现，请手动访问 http://NAS地址:$PORT" >> "$LOGF" 2>/dev/null
  fi
fi

# Node 可执行权限（tar 打包可能丢失执行位）
chmod -R +x "$APP_ROOT/target/node/bin" 2>/dev/null || true

# 兼容 1.5.0~1.6.0 的坏包：这些版本的 node/bin 里残留了指向已删除 lib/node_modules 的
# 断链软链接（如 bin/corepack），系统的 chown/chmod/setfacl -R 遇到断链会返回 ENOENT，
# 安装器即报「设置目录权限失败」。升级场景下先清一次，避免旧文件带进来。
if [ -d "$APP_ROOT/target" ]; then
  find "$APP_ROOT/target" -type l 2>/dev/null | while IFS= read -r _l; do
    [ -e "$_l" ] || rm -f "$_l" 2>/dev/null
  done
fi
exit 0
